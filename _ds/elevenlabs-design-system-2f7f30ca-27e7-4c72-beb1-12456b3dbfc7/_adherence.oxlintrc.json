{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/atmospheric/**",
              "components/buttons/**",
              "components/cards/**",
              "components/forms/**",
              "components/navigation/**",
              "components/pricing/**",
              "components/voice/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond|Inter))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioWaveformCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|playing|bars|key|ref|className|style|children)$/]",
        "message": "<AudioWaveformCard> doesn't accept that prop. Declared props: name, meta, playing, bars."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|dark|success)$/]",
        "message": "<Badge> tone must be one of 'default' | 'dark' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|icon|children|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: eyebrow, title, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|children|align|key|ref|className|style|children)$/]",
        "message": "<GradientOrbCard> doesn't accept that prop. Declared props: variant, title, children, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mint|peach|lavender|sky|rose)$/]",
        "message": "<GradientOrbCard> variant must be one of 'mint' | 'peach' | 'lavender' | 'sky' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<GradientOrbCard> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|period|blurb|features|cta|featured|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, period, blurb, features, cta, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|initials|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, name, role, initials."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: items, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|accent|initials|onPreview|last|key|ref|className|style|children)$/]",
        "message": "<VoiceRow> doesn't accept that prop. Declared props: name, accent, initials, onPreview, last."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
